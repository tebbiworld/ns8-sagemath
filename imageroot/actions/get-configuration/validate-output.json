{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/sagemath/get-configuration-output.json",
    "description": "Current SageMath module configuration",
    "type": "object",
    "properties": {
        "host": { "type": "string" },
        "http2https": { "type": "boolean" },
        "lets_encrypt": { "type": "boolean" },
        "public_url": { "type": "string" },
        "admin_users": { "type": "string" },
        "ldap_enabled": { "type": "boolean" },
        "ldap_url": { "type": "string" },
        "ldap_base_dn": { "type": "string" },
        "ldap_bind_dn": { "type": "string" },
        "ldap_bind_password": { "type": "string" },
        "ldap_group": { "type": "string" },
        "ldap_user_attribute": { "type": "string" }
    }
}
