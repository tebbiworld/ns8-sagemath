# Remove the single Traefik route created by configure-module. Containers,
# volumes and the podman network live inside the module user and are removed
# with it.

import os
import sys
import json

import agent
import agent.tasks

# stdin is consumed even if unused, to follow the action protocol.
json.load(sys.stdin)

default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is None:
    sys.exit(2)

module_id = os.environ['MODULE_ID']
response = agent.tasks.run(
    agent_id=default_traefik_id,
    action='delete-route',
    data={'instance': module_id},
)
agent.assert_exp(response['exit_code'] == 0)
