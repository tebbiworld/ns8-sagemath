# Copy the non-secret settings of the original instance. The bind password
# comes back with the restored state/passwords.env; a backup taken with an
# older module version still carries it in the environment.

import json
import sys

import agent
import modsecrets

request = json.load(sys.stdin)
env = request["environment"]

KEEP = ["TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT", "HUB_ADMIN_USERS",
        "LDAP_ENABLED", "LDAP_URL", "LDAP_BASE_DN", "LDAP_BIND_DN", "LDAP_GROUP", "LDAP_USER_ATTRIBUTE"]

agent.mset_env({k: env[k] for k in KEEP if k in env})

if env.get("LDAP_BIND_PASSWORD"):
    modsecrets.write({"LDAP_BIND_PASSWORD": env["LDAP_BIND_PASSWORD"]})
    print("restored the legacy bind password from the backup environment into passwords.env", file=sys.stderr)
modsecrets.ensure({})
