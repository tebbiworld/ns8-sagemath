# Re-apply the restored settings: every field configure-module accepts is
# passed. The bind password is left blank on purpose: blank = keep the restored
# value from passwords.env.

import os
import sys

import agent

env = os.environ

if not env.get("TRAEFIK_HOST"):
    # The original instance was backed up before it was ever configured: there
    # is nothing to re-apply, and configure-module requires a host name.
    print(agent.SD_NOTICE + "no host name in the restored settings: configure the module from the UI", file=sys.stderr)
    sys.exit(0)

data = {
    "host": env["TRAEFIK_HOST"],
    "http2https": env.get("TRAEFIK_HTTP2HTTPS", "True") == "True",
    "lets_encrypt": env.get("TRAEFIK_LETS_ENCRYPT", "False") == "True",
    "admin_users": env.get("HUB_ADMIN_USERS", ""),
    "ldap_enabled": env.get("LDAP_ENABLED", "False") == "True",
    "ldap_url": env.get("LDAP_URL", ""),
    "ldap_base_dn": env.get("LDAP_BASE_DN", ""),
    "ldap_bind_dn": env.get("LDAP_BIND_DN", ""),
    "ldap_bind_password": "",
    "ldap_group": env.get("LDAP_GROUP", ""),
    "ldap_user_attribute": env.get("LDAP_USER_ATTRIBUTE", "sAMAccountName"),
}
if "TRAEFIK_LETS_ENCRYPT" not in env:
    # A backup taken with a module version that did not record the setting: say
    # so instead of silently asserting "off". The route is created without a
    # certificate request; enable Let's Encrypt again in the settings.
    data.pop("lets_encrypt", None)
    print(agent.SD_WARNING + "the backup does not tell whether Let's Encrypt was enabled: the route is restored without it", file=sys.stderr)

response = agent.tasks.run(agent_id=env["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "The configure-module subtask failed!")
