# Publish SageMath through Traefik on a single host name. The JupyterHub proxy
# (configurable-http-proxy) inside the container already routes "/hub", "/user"
# and the WebSocket upgrades that the notebook kernels rely on, so a single
# Traefik route to the published loopback port is enough. Traefik forwards the
# WebSocket upgrade transparently, which the interactive kernels require.

import os
import sys
import json

import agent

data = json.load(sys.stdin)

host = data["host"]
h2hs = data.get("http2https", True)
module_id = os.environ["MODULE_ID"]
tcp_port = os.environ["TCP_PORT"]

route = {
    "instance": module_id,
    "url": "http://127.0.0.1:" + tcp_port,
    "host": host,
    "http2https": h2hs,
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
}
if "lets_encrypt" in data:
    route["lets_encrypt"] = data["lets_encrypt"]

agent.set_route(route)
