# Apply the SageMath module configuration.
#
# Two kinds of settings are written:
#   * agent.set_env(...) -> state/environment, read back by get-configuration and
#     the list-ldap-groups action, and expanded by the systemd unit (TCP_PORT,
#     SAGEMATH_APP_IMAGE, TRAEFIK_*).
#   * state/hub.env -> passed to the JupyterHub container with --env-file. This
#     is where the LDAP/AD and hub settings actually reach jupyterhub_config.py.

import os
import subprocess
import sys
import json
import urllib.parse

import agent
import modsecrets

data = json.load(sys.stdin)

host = data.get("host")
h2hs = data.get("http2https", True)
lets_encrypt = data.get("lets_encrypt", False)

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
# kept so restore-module can re-create the route with the same setting
agent.set_env("TRAEFIK_LETS_ENCRYPT", lets_encrypt)

scheme = "https" if (lets_encrypt or h2hs) else "http"
agent.set_env("SAGEMATH_ROOT_URL", f"{scheme}://{host}")

# Optional comma-separated list of AD login names granted hub-admin rights.
admin_users = (data.get("admin_users") or "").strip()
agent.set_env("HUB_ADMIN_USERS", admin_users)

# --- LDAP / Active Directory login -------------------------------------------
# Users log in with their AD account; each gets a private, persistent SageMath
# notebook home. Membership of the selected group (by full DN) restricts access.
ldap_enabled = bool(data.get("ldap_enabled", False))
ldap_url = (data.get("ldap_url") or "").strip().rstrip("/")
ldap_base_dn = (data.get("ldap_base_dn") or "").strip()
ldap_bind_dn = (data.get("ldap_bind_dn") or "").strip()
# The bind password is a secret: state/passwords.env, not the module
# environment. A blank field keeps the stored value.
ldap_bind_password = data.get("ldap_bind_password") or modsecrets.get("LDAP_BIND_PASSWORD")
ldap_group = (data.get("ldap_group") or "").strip()
ldap_user_attribute = (data.get("ldap_user_attribute") or "sAMAccountName").strip()

# Persist for get-configuration / list-ldap-groups (readable settings).
agent.set_env("LDAP_ENABLED", ldap_enabled)
agent.set_env("LDAP_URL", ldap_url)
agent.set_env("LDAP_BASE_DN", ldap_base_dn)
agent.set_env("LDAP_BIND_DN", ldap_bind_dn)
modsecrets.write({"LDAP_BIND_PASSWORD": ldap_bind_password})
agent.set_env("LDAP_GROUP", ldap_group)
agent.set_env("LDAP_USER_ATTRIBUTE", ldap_user_attribute)

ldap_host = ""
ldap_port = "636"
if ldap_url:
    parts = urllib.parse.urlsplit(ldap_url)
    ldap_host = parts.hostname or ""
    ldap_port = str(parts.port or (389 if parts.scheme == "ldap" else 636))
agent.set_env("LDAP_HOST", ldap_host)
agent.set_env("LDAP_PORT", ldap_port)

# The container cannot reach its own node's IP address (rootless network); when
# the directory server runs on this very node the hub must talk to
# host.containers.internal instead. See bin/ldap-container-host.
container_ldap_host = ldap_host
if ldap_host:
    container_ldap_host = subprocess.run(
        [os.path.expanduser("~/.config/bin/ldap-container-host"), ldap_host],
        capture_output=True, text=True, check=True,
    ).stdout.strip() or ldap_host


# --- Container env file (--env-file) -----------------------------------------
# Only the values jupyterhub_config.py consumes. Written atomically.
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    "HUB_BASE_URL=/",
    f"HUB_ADMIN_USERS={admin_users}",
    f"LDAP_ENABLED={'true' if (ldap_enabled and ldap_host and ldap_base_dn) else 'false'}",
    f"LDAP_HOST={container_ldap_host}",
    f"LDAP_PORT={ldap_port}",
    f"LDAP_BASE_DN={ldap_base_dn}",
    f"LDAP_BIND_DN={ldap_bind_dn}",
    f"LDAP_BIND_PASSWORD={ldap_bind_password}",
    f"LDAP_GROUP={ldap_group}",
    f"LDAP_USER_ATTRIBUTE={ldap_user_attribute}",
]
# hub.env carries the bind password: keep it private
os.umask(0o077)
with open("hub.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("hub.env.tmp", "hub.env")
