# Enable and (re)start the SageMath JupyterHub container so configuration
# changes (host name, LDAP settings) are applied.

import subprocess

subprocess.run(["systemctl", "--user", "enable", "sagemath.service"], check=True)
subprocess.run(["systemctl", "--user", "restart", "sagemath.service"], check=True)
