# Up to 1.0.1 the LDAP bind password was stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move it to
# state/passwords.env (0600); the value does not change.

import os

import modsecrets

modsecrets.migrate_from_env(["LDAP_BIND_PASSWORD"])

# hub.env carries the bind password as well
path = os.path.join(os.environ["AGENT_STATE_DIR"], "hub.env")
if os.path.exists(path):
    os.chmod(path, 0o600)
