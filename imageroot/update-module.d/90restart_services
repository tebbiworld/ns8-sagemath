#
# The core's update-module action does not restart the module's units, so unit
# or config changes would only apply at the next reboot. This hook also re-runs
# the same-node LDAP detection (1.0.1, see bin/ldap-container-host) on the hub
# env file written by an older configure-module.
#

import os
import re
import subprocess
import sys

import agent

sys.stdout = sys.stderr  # any output goes to the journal

env = agent.read_envfile("environment")
ldap_host = env.get("LDAP_HOST", "")
if ldap_host and os.path.isfile("hub.env"):
    chost = subprocess.run(
        [os.path.expanduser("~/.config/bin/ldap-container-host"), ldap_host],
        capture_output=True, text=True, check=True,
    ).stdout.strip() or ldap_host
    with open("hub.env") as fp:
        content = fp.read()
    new = re.sub(r"^LDAP_HOST=.*$", f"LDAP_HOST={chost}", content, flags=re.M)
    if new != content:
        with open("hub.env.tmp", "w") as fp:
            fp.write(new)
        os.replace("hub.env.tmp", "hub.env")
        print(f"hub.env: LDAP_HOST -> {chost}")

subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
subprocess.run(["systemctl", "--user", "try-restart", "sagemath.service"], check=True)
